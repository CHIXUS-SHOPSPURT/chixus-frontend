# =============================================================================
# CHIXUS Frontend Environment Variables (Vercel & Local Deployment)
# =============================================================================
# Set these variables in your Vercel Project Settings (Project -> Settings -> Environment Variables)
# or in a local .env file.
#
# Render Backend Example:
#   VITE_BACKEND_URL=https://your-service-name.onrender.com
#   VITE_WS_URL=wss://your-service-name.onrender.com/ws/rear-camera-stream
#
# Render Aliases:
#   VITE_RENDER_URL=https://your-service-name.onrender.com
#   VITE_RENDER_WS_URL=wss://your-service-name.onrender.com/ws/rear-camera-stream
#
# Note: If VITE_WS_URL is omitted, the frontend automatically derives wss://
# from VITE_BACKEND_URL. If VITE_BACKEND_URL is omitted, requests use relative paths.

VITE_BACKEND_URL=
VITE_WS_URL=

VITE_RENDER_URL=
VITE_RENDER_WS_URL=

VITE_FASTAPI_URL=
VITE_FASTAPI_WS_URL=
