# =============================================================================
# CHIXUS Decoupled Backend & WebSocket Configuration
# =============================================================================
# Set these variables when connecting the frontend to your external FastAPI host.
#
# Examples:
# Local FastAPI server:
#   VITE_BACKEND_URL=http://localhost:8000
#   VITE_WS_URL=ws://localhost:8000/ws/rear-camera-stream
#
# Production Cloud Deployment:
#   VITE_BACKEND_URL=https://api.chixus.network
#   VITE_WS_URL=wss://api.chixus.network/ws/rear-camera-stream
#
# Note: If left unset, the frontend connects to the integrated development proxy.

VITE_BACKEND_URL=
VITE_WS_URL=

# Legacy compatibility aliases
VITE_FASTAPI_URL=
VITE_FASTAPI_WS_URL=
